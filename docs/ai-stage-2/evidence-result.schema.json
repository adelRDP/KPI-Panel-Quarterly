{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KPI evidence review v3 model output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "criteria",
    "observedFacts",
    "limitations"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2400
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterionId",
          "status",
          "levelId",
          "reason",
          "evidenceRefs",
          "missingEvidence",
          "conflicts"
        ],
        "properties": {
          "criterionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "status": {
            "type": "string",
            "enum": [
              "met",
              "partially_met",
              "unmet",
              "insufficient",
              "conflicting"
            ]
          },
          "levelId": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 160
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          },
          "evidenceRefs": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "missingEvidence": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200
            }
          },
          "conflicts": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200
            }
          }
        }
      }
    },
    "observedFacts": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fieldKey",
          "rawValue",
          "unit",
          "evidenceRefs",
          "uncertain"
        ],
        "properties": {
          "fieldKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "rawValue": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "unit": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          },
          "evidenceRefs": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "uncertain": {
            "type": "boolean"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1200
      }
    }
  }
}
