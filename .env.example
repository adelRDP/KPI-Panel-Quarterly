# Default: signed-in local Codex/ChatGPT account. No API key needed.
LLM_PROVIDER=codex
# CODEX_PATH=C:/path/to/codex.exe
# Default: gpt-6-luna with medium reasoning. Override only when needed.
# CODEX_MODEL=gpt-6-luna

# Optional future providers. Keys stay on the server, never in the browser.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=

# Visual preprocessing is separate from final activity review. Default is local-only:
# images/scanned pages are NOT sent to any model and remain non-final.
PREPROCESS_PROVIDER=local
# Optional: ling, openai, or gemini. Enable only after organizational data approval.
# PREPROCESS_PROVIDER=ling
# PREPROCESS_NETWORK_ENABLED=true
# PREPROCESS_DATA_AUTHORIZED=true
# LING_API_KEY=
# PREPROCESS_LING_MODEL=Ling-3.0-flash-VL
# PREPROCESS_OPENAI_MODEL=
# PREPROCESS_GEMINI_MODEL=
# Required for any remote preprocessor: configure verified $/million-token rates and per-document ceiling.
# Ling-3.0-flash-VL price was not confirmed in the official public pricing table; do not guess it.
# PREPROCESS_INPUT_USD_PER_MTOK=
# PREPROCESS_OUTPUT_USD_PER_MTOK=
# PREPROCESS_MAX_COST_USD=
PORT=4273
PANEL_SUPERVISOR_PORT=4272

# hybrid preserves the original role switcher and adds individual role logins.
# demo = shared entry only; local = individual entry only.
PANEL_AUTH_MODE=hybrid
# Independent accounts are optional: bootstrap the first existing admin locally,
# then choose PANEL_AUTH_MODE=local. Never put passwords in this file or CLI args.
# Local daily complete backups (database + all original attachments) stay out of Git.
# On normal local startup this is enabled; on explicit/custom data roots opt in.
# PANEL_BACKUP_ENABLED=true
# PANEL_BACKUP_ROOT=E:/private-project/data/local/backups

# Hosting only: keep default loopback for local use. Set these on a trusted HTTPS VM.
# PANEL_BIND_HOST=0.0.0.0
# PANEL_PUBLIC_ORIGIN=https://your-subdomain.style.dev
# PANEL_PUBLIC_ORIGINS=https://another-trusted-domain.example
# PANEL_DATA_ROOT=/srv/kpi-quarterly-panel/data/processed/kpi-panel
# PANEL_UPLOAD_ROOT=/srv/kpi-quarterly-panel/data/raw/kpi-panel
